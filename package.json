{
  "name": "bilioffice",
  "version": "0.1.3",
  "private": true,
  "description": "Bilibili office chat UI userscript with WeCom, DingTalk and Feishu themes",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check dist/bilioffice.user.js",
    "test": "node tests/browser-regression.mjs",
    "test:unit": "node tests/unit.mjs",
    "typecheck": "tsc --noEmit",
    "test:live": "node tests/live.mjs",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/*.mjs\" \"tests/*.mjs\"",
    "pretest": "npm run build",
    "pretest:live": "npm run build",
    "test:live:player": "npm run build && node tests/native-player-interactions-live.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "playwright": "1.65.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
